# Copy to .env and replace every placeholder. Keep .env private.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,proxy.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://proxy.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_PROXY_SSL_HEADER=true
# Set HSTS only after HTTPS is working for this host.
# DJANGO_SECURE_HSTS_SECONDS=31536000

POSTGRES_DB=llm_proxy
POSTGRES_USER=llm_proxy
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=8000

UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=replace-with-your-provider-key
UPSTREAM_MODELS=
PROXY_API_KEY=replace-with-a-separate-long-random-key

# Prompt and completion bodies are logged by default. Disable if that is not acceptable.
REQUEST_LOG_STORE_BODIES=false
REQUEST_LOG_RETENTION_DAYS=90
